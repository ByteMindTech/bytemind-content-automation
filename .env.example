# ─────────────────────────────────────────────────────────────
# ByteMind Content Automation Platform — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────
APP_ENV=development           # development | production
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true
LOG_LEVEL=INFO

# ── Security ──────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=your-64-char-random-secret-here
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# API key for GitHub Actions service account (no JWT needed)
ACTIONS_API_KEY=your-github-actions-api-key-here

# ── PostgreSQL ────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://your_user:your_password@localhost:5432/your_database
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ── Redis (optional — for rate limiting persistence) ──────────
REDIS_URL=redis://localhost:6379/0

# ── AI Providers ──────────────────────────────────────────────
# Primary: Gemini
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.1-pro
GEMINI_MAX_TOKENS=8192
GEMINI_TEMPERATURE=0.7

# Fallback: OpenAI
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o
OPENAI_MAX_TOKENS=4096

# Controls which provider is used: gemini | openai | auto (gemini first, fallback to openai)
AI_PROVIDER=auto

# ── Medium Publishing ─────────────────────────────────────────
MEDIUM_INTEGRATION_TOKEN=your-medium-integration-token-here
MEDIUM_AUTHOR_ID=your-medium-author-id-here
# Set to true to skip actual Medium API calls (safe default)
MEDIUM_DRY_RUN=true 
MEDIUM_DEFAULT_STATUS=draft        # draft | public | unlisted
MEDIUM_CANONICAL_BASE_URL=https://example.com/blogs

# ── Content Source ────────────────────────────────────────────
# Path to ByteMindTech blog content (used in local dev mode)
CONTENT_SOURCE_PATH=../path/to/your/local/blog/content
CONTENT_WATCH_EXTENSIONS=.md

# ── Scheduling ────────────────────────────────────────────────
SCHEDULER_TIMEZONE=Europe/Paris
# Cron for automatic publishing (default: every Friday 10:00 AM)
SCHEDULER_PUBLISH_CRON=0 10 * * 5

# ── Rate Limiting ─────────────────────────────────────────────
RATE_LIMIT_GENERATE=10/minute
RATE_LIMIT_PUBLISH=5/minute
RATE_LIMIT_GLOBAL=100/minute

# ── CORS ─────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,https://example.com

# ── SMTP (OVH Email for approval notifications) ──────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=your-smtp-user@example.com
SMTP_PASSWORD=your-smtp-password-here
SMTP_FROM_NAME=Your App Name

# ── Approval Workflow ─────────────────────────────────────────
# Email address to receive approval notifications
APPROVAL_EMAIL=approvals@example.com
# Base URL for approve/reject links (must be publicly accessible)
APPROVAL_BASE_URL=https://api.example.com
# How long approve/reject links remain valid (hours)
APPROVAL_TOKEN_EXPIRY_HOURS=72
# Articles with quality_score >= this threshold are auto-approved (skip email)
AUTO_APPROVE_THRESHOLD=9
